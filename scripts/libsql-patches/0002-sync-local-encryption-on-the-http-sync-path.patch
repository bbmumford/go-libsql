+#[test]
+fn an_encrypted_export_holds_the_exported_pages_by_number() {
+    let dir = tempdir().unwrap();
+    let path = dir.path().join("replica.db");
+    let export = fixture(false).export;
+    super::write_encrypted_export(path.to_str().unwrap(), &export, &key()).unwrap();
+    assert_eq!(file_names(dir.path()), vec!["replica.db".to_string()]);
+    let written = std::fs::read(&path).unwrap();
+    assert_eq!(written.len(), export.len(), "one encrypted page per exported page");
+    assert_ne!(&written[..16], &SQLITE_HEADER[..]);
+    assert!(!contains(&written, EXPORT_MARKER));
+
+    let mut db = crate::local::Database::new(path.to_str().unwrap().to_string(), OpenFlags::SQLITE_OPEN_READ_ONLY);
+    db.encryption_config = Some(key());
+    let conn = db.connect().unwrap();
+    let one = |sql: &str| -> crate::Value {
+        let rows = conn.query(sql, Params::None).unwrap().unwrap();
+        let row = rows.next().unwrap().unwrap();
+        row.get_value(0).unwrap()
+    };
+    assert_eq!(one("PRAGMA integrity_check"), crate::Value::Text("ok".to_string()));
+    assert_eq!(one("PRAGMA page_count"), crate::Value::Integer((export.len() / 4096) as i64));
+    assert_eq!(
+        one(&format!("SELECT count(*) FROM t WHERE x LIKE '{EXPORT_MARKER}%'")),
+        crate::Value::Integer(300)
+    );
+}
