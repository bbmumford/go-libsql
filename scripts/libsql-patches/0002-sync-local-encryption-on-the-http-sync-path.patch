+/// Writes a db export to `path` encrypted with `encryption_config`, so the export's pages reach
+/// the disk only through the cipher. The pages go, as one transaction of WAL frames, into a new
+/// database beside `path` opened with the key; that WAL is checkpointed into the new file, and
+/// the file is renamed over `path`. Page numbers and contents stay the export's, because
+/// `try_pull` later inserts the frames pulled from `/sync` on top of them by page number, and
+/// the WAL is left empty, because those frames are inserted from frame 1.
+fn write_encrypted_export(
+    path: &str,
+    data: &[u8],
+    encryption_config: &crate::EncryptionConfig,
+) -> Result<()> {
+    const HEADER: &[u8; 16] = b"SQLite format 3\0";
+    if data.len() < 100 || &data[..16] != HEADER {
+        return Err(SyncError::InvalidExport("not a SQLite database file".to_string()).into());
+    }
+    let page_size = match u16::from_be_bytes([data[16], data[17]]) {
+        1 => 65536usize,
+        n => n as usize,
+    };
+    if page_size < 512 || !page_size.is_power_of_two() || data.len() % page_size != 0 {
+        return Err(SyncError::InvalidExport(format!(
+            "length {} is not a whole number of {page_size}-byte pages",
+            data.len()
+        ))
+        .into());
+    }
+    let page_count = (data.len() / page_size) as u32;
+
+    let directory = Path::new(path).parent().ok_or_else(|| {
+        SyncError::io("parent path")(std::io::Error::other(
+            "unable to get parent of the provided path",
+        ))
+    })?;
+    let timestamp = Utc::now().format("%Y%m%d_%H%M%S");
+    let temp_path = directory.join(format!(".tmp.{}.{}", timestamp, Uuid::new_v4()));
+    let temp = temp_path
+        .to_str()
+        .ok_or(crate::Error::InvalidUTF8Path)?
+        .to_owned();
+
+    let written = (|| -> Result<()> {
+        let mut db = crate::local::Database::new(
+            temp.clone(),
+            crate::OpenFlags::SQLITE_OPEN_READ_WRITE | crate::OpenFlags::SQLITE_OPEN_CREATE,
+        );
+        db.encryption_config = Some(encryption_config.clone());
+        let conn = db.connect()?;
+        conn.execute(&format!("PRAGMA page_size = {page_size}"), crate::params::Params::None)?;
+        let journal_mode = conn
+            .query("PRAGMA journal_mode = WAL", crate::params::Params::None)?
+            .ok_or_else(|| SyncError::InvalidLocalState("journal_mode returned no row".into()))?
+            .next()?
+            .ok_or_else(|| SyncError::InvalidLocalState("journal_mode returned no row".into()))?
+            .get::<String>(0)?;
+        if !journal_mode.eq_ignore_ascii_case("wal") {
+            return Err(SyncError::InvalidLocalState(format!(
+                "encrypted export opened in journal mode {journal_mode}, not wal"
+            ))
+            .into());
+        }
+        {
+            let insert_handle = conn.wal_insert_handle();
+            insert_handle.begin()?;
+            let mut frame = vec![0u8; FRAME_HEADER_SIZE + page_size];
+            for (index, page) in data.chunks_exact(page_size).enumerate() {
+                let page_no = index as u32 + 1;
+                let size_after = if page_no == page_count { page_count } else { 0 };
+                frame[..FRAME_HEADER_SIZE].fill(0);
+                frame[0..4].copy_from_slice(&page_no.to_be_bytes());
+                frame[4..8].copy_from_slice(&size_after.to_be_bytes());
+                frame[FRAME_HEADER_SIZE..].copy_from_slice(page);
+                insert_handle.insert_at(page_no, &frame)?;
+            }
+            insert_handle.end()?;
+        }
+        conn.wal_checkpoint(true)?;
+        drop(conn);
+        drop(db);
+        std::fs::File::open(&temp_path)
+            .and_then(|f| f.sync_all())
+            .map_err(SyncError::io("encrypted export sync_all"))?;
+        std::fs::rename(&temp_path, path).map_err(SyncError::io("atomic rename"))?;
+        Ok(())
+    })();
+
+    if written.is_err() {
+        for suffix in ["", "-wal", "-shm", "-journal"] {
+            let _ = std::fs::remove_file(format!("{temp}{suffix}"));
+        }
+    }
+    written
+}
