@@ -0,0 +1,419 @@
+//! Local encryption at rest on the HTTP sync (synced database) path.
+//!
+//! An in-process server answers the HTTP sync protocol the synced database speaks
+//! (`/info`, `/export/{generation}`, `GET` and `POST /sync/{generation}/{start}/{end}`)
+//! from a plaintext database built for each test, as a primary that answers
+//! `/info` does. Every file the client leaves in the replica's directory
+//! (the database, its WAL and shared-memory index, the `-info` metadata, and any
+//! temporary file of the bootstrap) is then searched for the rows' text.
+use crate::database::OpenFlags;
+use crate::params::Params;
+use crate::util::{ConnectorService, Socket};
+use crate::{Builder, Cipher, EncryptionConfig};
+use hyper::Body;
+use std::path::Path;
+use std::pin::Pin;
+use std::sync::{Arc, Mutex};
+use std::task::{Context, Poll};
+use tempfile::tempdir;
+use tokio::io::{duplex, AsyncRead, AsyncWrite, DuplexStream};
+use tower::Service;
+
+const EXPORT_MARKER: &str = "EXPORT-MARKER-6f1c2b";
+const FRAME_MARKER: &str = "FRAME-MARKER-9a7d3e";
+const PUSH_MARKER: &str = "PUSH-MARKER-41c8e0";
+const SQLITE_HEADER: &[u8; 16] = b"SQLite format 3\0";
+const FRAME_SIZE: usize = 4096 + 24;
+
+fn key() -> EncryptionConfig {
+    EncryptionConfig::new(Cipher::Aes256Cbc, bytes::Bytes::from_static(b"0123456789abcdef0123456789abcdef"))
+}
+
+fn wrong_key() -> EncryptionConfig {
+    EncryptionConfig::new(Cipher::Aes256Cbc, bytes::Bytes::from_static(b"fedcba9876543210fedcba9876543210"))
+}
+
+/// The plaintext server side: the database file `/export/1` returns, and the WAL
+/// frames of generation 1 that `GET /sync/1/...` returns after it.
+struct Fixture {
+    export: Vec<u8>,
+    frames: Vec<Vec<u8>>,
+}
+
+/// Builds the server's plaintext database: 300 rows holding EXPORT_MARKER in the
+/// exported file and, when `with_frames`, 300 rows holding FRAME_MARKER in WAL
+/// frames written after the export.
+fn fixture(with_frames: bool) -> Fixture {
+    let dir = tempdir().unwrap();
+    let path = dir.path().join("server.db");
+    let db = crate::local::Database::new(path.to_str().unwrap().to_string(), OpenFlags::default());
+    let conn = db.connect().unwrap();
+    conn.query("PRAGMA journal_mode = WAL", Params::None).unwrap();
+    conn.execute("CREATE TABLE t(x TEXT)", Params::None).unwrap();
+    conn.execute(
+        &format!(
+            "WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM c WHERE i < 300) \
+             INSERT INTO t(x) SELECT '{EXPORT_MARKER}-' || i FROM c"
+        ),
+        Params::None,
+    )
+    .unwrap();
+    conn.wal_checkpoint(true).unwrap();
+    let export = std::fs::read(&path).unwrap();
+    assert_eq!(&export[..16], SQLITE_HEADER);
+    assert!(export.len() > 4096, "the export spans several pages");
+
+    let mut frames = Vec::new();
+    if with_frames {
+        conn.query("PRAGMA wal_autocheckpoint = 0", Params::None).unwrap();
+        conn.execute(
+            &format!(
+                "WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM c WHERE i < 300) \
+                 INSERT INTO t(x) SELECT '{FRAME_MARKER}-' || i FROM c"
+            ),
+            Params::None,
+        )
+        .unwrap();
+        for frame_no in 1..=conn.wal_frame_count() {
+            let frame = conn.wal_get_frame(frame_no, 4096).unwrap();
+            assert_eq!(frame.len(), FRAME_SIZE);
+            frames.push(frame.to_vec());
+        }
+        assert!(frames.len() > 1);
+    }
+    Fixture { export, frames }
+}
+
+struct Server {
+    connector: ConnectorService,
+    pushed: Arc<Mutex<Vec<u8>>>,
+}
+
+impl Server {
+    fn start(fixture: Fixture) -> Self {
+        let fixture = Arc::new(fixture);
+        let pushed = Arc::new(Mutex::new(Vec::new()));
+        let (tx, mut rx) = tokio::sync::mpsc::channel::<DuplexStream>(16);
+        let connector = ConnectorService::new(MockConnector { tx });
+
+        let pushed_by_server = pushed.clone();
+        tokio::spawn(async move {
+            while let Some(stream) = rx.recv().await {
+                let fixture = fixture.clone();
+                let pushed = pushed_by_server.clone();
+                tokio::spawn(async move {
+                    let service = hyper::service::service_fn(move |req: http::Request<Body>| {
+                        let fixture = fixture.clone();
+                        let pushed = pushed.clone();
+                        async move { Ok::<_, hyper::Error>(answer(&fixture, &pushed, req).await) }
+                    });
+                    let _ = hyper::server::conn::Http::new()
+                        .serve_connection(stream, service)
+                        .await;
+                });
+            }
+        });
+        Self { connector, pushed }
+    }
+
+    fn url(&self) -> String {
+        "http://sync.test".to_string()
+    }
+
+    fn pushed(&self) -> Vec<u8> {
+        self.pushed.lock().unwrap().clone()
+    }
+}
+
+async fn answer(fixture: &Fixture, pushed: &Mutex<Vec<u8>>, req: http::Request<Body>) -> http::Response<Body> {
+    let reply = |status: u16, body: Vec<u8>| {
+        http::Response::builder().status(status).body(Body::from(body)).unwrap()
+    };
+    let path = req.uri().path().to_string();
+    let method = req.method().clone();
+    let parts: Vec<&str> = path.trim_start_matches('/').split('/').collect();
+    match (method.as_str(), parts.as_slice()) {
+        ("GET", ["info"]) => reply(200, br#"{"current_generation":1}"#.to_vec()),
+        ("GET", ["export", "1"]) => reply(200, fixture.export.clone()),
+        ("GET", ["sync", "1", start, end]) => {
+            let start: usize = start.parse().unwrap();
+            let end: usize = end.parse().unwrap();
+            if start == 0 || start > fixture.frames.len() {
+                return reply(400, br#"{"generation":1}"#.to_vec());
+            }
+            let last = end.min(fixture.frames.len() + 1);
+            reply(200, fixture.frames[start - 1..last - 1].concat())
+        }
+        ("POST", ["sync", "1", _start, end, ..]) => {
+            let end: u32 = end.parse().unwrap();
+            let body = hyper::body::to_bytes(req.into_body()).await.unwrap();
+            pushed.lock().unwrap().extend_from_slice(&body);
+            let json = format!(r#"{{"status":"ok","generation":1,"max_frame_no":{}}}"#, end - 1);
+            reply(200, json.into_bytes())
+        }
+        _ => reply(404, b"not found".to_vec()),
+    }
+}
+
+#[derive(Clone)]
+struct MockConnector {
+    tx: tokio::sync::mpsc::Sender<DuplexStream>,
+}
+
+impl Service<http::Uri> for MockConnector {
+    type Response = Box<dyn Socket>;
+    type Error = Box<dyn std::error::Error + Send + Sync>;
+    type Future = Pin<Box<dyn std::future::Future<Output = Result<Self::Response, Self::Error>> + Send>>;
+
+    fn poll_ready(&mut self, _: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        Poll::Ready(Ok(()))
+    }
+
+    fn call(&mut self, _: http::Uri) -> Self::Future {
+        let (stream, server_stream) = duplex(1 << 16);
+        let tx = self.tx.clone();
+        Box::pin(async move {
+            tx.send(server_stream).await.map_err(|e| e.to_string())?;
+            Ok(Box::new(MockConnection { stream }) as Box<dyn Socket>)
+        })
+    }
+}
+
+struct MockConnection {
+    stream: DuplexStream,
+}
+
+impl AsyncRead for MockConnection {
+    fn poll_read(mut self: Pin<&mut Self>, cx: &mut Context<'_>, buf: &mut tokio::io::ReadBuf<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.stream).poll_read(cx, buf)
+    }
+}
+
+impl AsyncWrite for MockConnection {
+    fn poll_write(mut self: Pin<&mut Self>, cx: &mut Context<'_>, buf: &[u8]) -> Poll<std::io::Result<usize>> {
+        Pin::new(&mut self.stream).poll_write(cx, buf)
+    }
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.stream).poll_flush(cx)
+    }
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.stream).poll_shutdown(cx)
+    }
+}
+
+impl hyper::client::connect::Connection for MockConnection {
+    fn connected(&self) -> hyper::client::connect::Connected {
+        hyper::client::connect::Connected::new()
+    }
+}
+
+fn header(path: &Path) -> Vec<u8> {
+    let bytes = std::fs::read(path).unwrap();
+    bytes[..16].to_vec()
+}
+
+fn contains(haystack: &[u8], needle: &str) -> bool {
+    haystack.windows(needle.len()).any(|w| w == needle.as_bytes())
+}
+
+/// Every file in `dir` with the markers it holds in plaintext.
+fn plaintext_markers(dir: &Path, markers: &[&str]) -> Vec<String> {
+    let mut found = Vec::new();
+    for entry in std::fs::read_dir(dir).unwrap() {
+        let entry = entry.unwrap();
+        if !entry.file_type().unwrap().is_file() {
+            continue;
+        }
+        let bytes = std::fs::read(entry.path()).unwrap();
+        for marker in markers {
+            if contains(&bytes, marker) {
+                found.push(format!("{} holds {marker}", entry.file_name().to_string_lossy()));
+            }
+        }
+    }
+    found
+}
+
+fn file_names(dir: &Path) -> Vec<String> {
+    let mut names: Vec<String> = std::fs::read_dir(dir)
+        .unwrap()
+        .map(|e| e.unwrap().file_name().to_string_lossy().to_string())
+        .collect();
+    names.sort();
+    names
+}
+
+async fn count_local(path: &Path, key: Option<EncryptionConfig>, like: &str) -> crate::Result<i64> {
+    let mut builder = Builder::new_local(path);
+    if let Some(key) = key {
+        builder = builder.encryption_config(key);
+    }
+    let db = builder.build().await?;
+    let conn = db.connect()?;
+    let mut rows = conn
+        .query(&format!("SELECT count(*) FROM t WHERE x LIKE '{like}%'"), ())
+        .await?;
+    let row = rows.next().await?.expect("count row");
+    Ok(row.get::<i64>(0)?)
+}
