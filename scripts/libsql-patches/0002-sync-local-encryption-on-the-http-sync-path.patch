+#[test]
+fn an_export_that_is_not_a_database_is_refused_and_leaves_no_file() {
+    let dir = tempdir().unwrap();
+    let path = dir.path().join("replica.db");
+    let path = path.to_str().unwrap();
+    let export = fixture(false).export;
+    assert!(super::write_encrypted_export(path, b"not a database", &key()).is_err());
+    let mut foreign = export.clone();
+    foreign[0] ^= 0xff;
+    assert!(super::write_encrypted_export(path, &foreign, &key()).is_err(), "a file without the SQLite header");
+    let mut torn = export.clone();
+    torn.truncate(torn.len() - 100);
+    assert!(super::write_encrypted_export(path, &torn, &key()).is_err(), "a file that ends inside a page");
+    assert!(file_names(dir.path()).is_empty(), "{:?}", file_names(dir.path()));
+}
