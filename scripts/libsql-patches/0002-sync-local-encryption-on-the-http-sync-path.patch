+    assert_eq!(count_local(&path, Some(key()), EXPORT_MARKER).await.unwrap(), 300);
+    assert_eq!(count_local(&path, Some(key()), FRAME_MARKER).await.unwrap(), 300);
+    assert!(count_local(&path, None, EXPORT_MARKER).await.is_err(), "opened without the key");
+    assert!(count_local(&path, Some(wrong_key()), EXPORT_MARKER).await.is_err(), "opened with another key");
+}
