+            .await
+            .unwrap();
+    }
+    db.sync().await.unwrap();
+    drop(db);
+
+    let pushed = server.pushed();
+    assert!(!pushed.is_empty() && pushed.len() % FRAME_SIZE == 0, "pushed {} bytes", pushed.len());
+    assert!(contains(&pushed, PUSH_MARKER), "the pushed frames carry the page encrypted");
+    let leaks = plaintext_markers(dir.path(), &[EXPORT_MARKER, PUSH_MARKER]);
+    assert!(leaks.is_empty(), "plaintext rows on disk: {leaks:?}");
+    assert_ne!(&header(&path)[..], &SQLITE_HEADER[..]);
+    assert_eq!(count_local(&path, Some(key()), PUSH_MARKER).await.unwrap(), 1);
+}
