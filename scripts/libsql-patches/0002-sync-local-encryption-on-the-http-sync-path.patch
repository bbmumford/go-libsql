+async fn keyed_synced_database_pushes_unencrypted_pages_and_keeps_its_own_encrypted() {
+    let server = Server::start(fixture(false));
+    let dir = tempdir().unwrap();
+    let path = dir.path().join("offline.db");
+    let db = Builder::new_synced_database(&path, server.url(), "token".to_string())
+        .connector(server.connector.clone())
