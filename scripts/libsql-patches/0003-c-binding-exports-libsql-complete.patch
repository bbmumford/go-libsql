+// Returns 1 when `sql` (NUL-terminated UTF-8) ends with a complete SQL
+// statement and 0 otherwise, by SQLite's sqlite3_complete in the SQLite this
+// library links: a caller cutting a multi-statement string at ';' needs that
+// tokenizer, and the shared library exports only the libsql_* functions, so
+// a caller of it declaring sqlite3_complete binds whichever system SQLite the
+// process loads, or none. A null `sql` returns 0.
+#[no_mangle]
+pub unsafe extern "C" fn libsql_complete(sql: *const std::ffi::c_char) -> std::ffi::c_int {
+    if sql.is_null() {
+        return 0;
+    }
+    unsafe { libsql::ffi::sqlite3_complete(sql) }
+}
